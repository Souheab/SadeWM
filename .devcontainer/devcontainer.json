{
  "name": "sadewm",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.1"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3"
    },
    "ghcr.io/devcontainers/features/nix:1": {
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential pkg-config gdb make libx11-dev libxext-dev libxft-dev libxinerama-dev libxcursor-dev libxi-dev libxtst-dev libfontconfig1-dev libfreetype6-dev libcairo2-dev xserver-xephyr xvfb xauth x11-utils x11-xserver-utils scrot mesa-utils libgl1-mesa-dri libglx-mesa0 xserver-xorg-video-dummy dbus dbus-x11 bluez python3-dbus python3-xlib libdbus-1-dev && python3 -m pip install --user -e ./xdrive && nix-env -iA nixpkgs.shellcheck nixpkgs.qt6Packages.qtdeclarative nixpkgs.qtcreator",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "jnoortheen.nix-ide",
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "mads-hartmann.bash-ide-vscode",
        "timonwong.shellcheck",
        "nickmillerdev.qml-tools",
        "theqtcompany.qt-qml",
        "ms-python.python"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.testOnSave": false,
        "gopls": {
          "build.directoryFilters": [
            "-wm/vendor"
          ],
          "formatting.gofumpt": true,
          "ui.semanticTokens": true
        },
        "go.testEnvVars": {
          "GOFLAGS": "-mod=vendor"
        },
        "C_Cpp.default.cStandard": "c99",
        "C_Cpp.default.compilerPath": "/usr/bin/cc",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}",
          "/usr/X11R6/include",
          "/usr/include/freetype2"
        ],
        "C_Cpp.default.defines": [
          "_DEFAULT_SOURCE",
          "_BSD_SOURCE",
          "_XOPEN_SOURCE=700L",
          "XINERAMA"
        ],
        "files.associations": {
          "*.qml": "qml"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
